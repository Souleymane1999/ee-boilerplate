# Environment variables — never commit real secrets
.env
.env.*
!.env.example

# Ruby / Rails
*.rbc
capybara-*.html
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*
/public/system
/coverage/
/spec/tmp/*
!/spec/tmp/.keep
/vendor/bundle
/.bundle
build/
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

/public/assets
/public/packs
/public/packs-test

# Node / Tailwind / esbuild
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
/app/assets/builds/*
!/app/assets/builds/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Design system (delta-force) — has its own .gitignore too (design-system/.gitignore)
design-system/node_modules/
design-system/nuxt-app/node_modules/
design-system/nuxt-app/.nuxt/
design-system/nuxt-app/.output/

# Backups produced locally by scripts/backup.sh
/backups/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
