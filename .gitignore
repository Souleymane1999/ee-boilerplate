# Environment variables — never commit real secrets
.env
.env.*
!.env.example

# Backend (Ruby / Rails) — see backend/.gitignore for the detailed version
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/vendor/bundle/
backend/.bundle/
backend/config/master.key
backend/public/assets
backend/storage/*
!backend/storage/.keep
backend/coverage/
backend/node_modules/
backend/app/assets/builds/*
!backend/app/assets/builds/.keep

# Design system (delta-force) — has its own .gitignore too (design-system/.gitignore)
design-system/node_modules/
design-system/nuxt-app/node_modules/
design-system/nuxt-app/.nuxt/
design-system/nuxt-app/.output/

# Backups produced locally by scripts/backup.sh
/backups/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
