<div class="flex min-h-screen flex-col bg-neutral-25 md:flex-row">
  <aside class="hidden w-64 shrink-0 flex-col justify-between border-r border-neutral-200 bg-white md:flex">
    <div>
      <div class="flex items-center px-6 py-6">
        <%= image_tag "ifutur-logo.png", alt: "iFutur", class: "h-7 w-auto" %>
      </div>
      <nav class="flex flex-col gap-1 px-3">
        <%= link_to dashboard_path, class: nav_link_classes(active == :dashboard) do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
          </svg>
          Tableau de bord
        <% end %>
        <%= link_to todos_path, class: nav_link_classes(active == :todos) do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0">
            <path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v14.5A1.75 1.75 0 0113.25 19h-6.5A1.75 1.75 0 015 17.25V2.75zm7.03 3.72a.75.75 0 00-1.06-1.06l-2.72 2.72-1.22-1.22a.75.75 0 00-1.06 1.06l1.75 1.75a.75.75 0 001.06 0l3.25-3.25z" clip-rule="evenodd" />
          </svg>
          Tâches
        <% end %>
      </nav>
    </div>

    <div class="border-t border-neutral-200 px-4 py-4">
      <div class="flex items-center gap-3 px-2 py-2">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-lime text-sm font-semibold text-brand-ink">
          <%= current_user.email.first.upcase %>
        </span>
        <span class="min-w-0 flex-1 truncate text-sm text-neutral-600"><%= current_user.email %></span>
      </div>
      <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete,
            class: "mt-2 w-full cursor-pointer rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm font-medium text-neutral-700 shadow-xs hover:bg-neutral-50" %>
    </div>
  </aside>

  <header class="flex items-center justify-between border-b border-neutral-200 bg-white px-4 py-3 md:hidden">
    <%= image_tag "ifutur-logo.png", alt: "iFutur", class: "h-6 w-auto" %>
    <div class="flex items-center gap-3">
      <span class="text-sm text-neutral-500"><%= current_user.email %></span>
      <%= button_to "Se déconnecter", destroy_user_session_path, method: :delete,
            class: "cursor-pointer rounded-md border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-neutral-700 shadow-xs hover:bg-neutral-50" %>
    </div>
  </header>

  <main class="flex-1 px-4 py-10 md:px-10">
    <div class="mx-auto max-w-3xl">
      <%= yield %>
    </div>
  </main>
</div>
