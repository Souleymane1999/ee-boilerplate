<% content_for :title, "#{@todo.title} — EE Boilerplate" %>

<%= render layout: "shared/app_shell", locals: { active: :todos } do %>
  <div class="overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-xs">
    <div class="flex items-center justify-between border-b border-neutral-100 px-6 py-4">
      <h1 class="text-lg font-semibold text-brand-ink"><%= @todo.title %></h1>
      <% if @todo.done %>
        <span class="inline-flex items-center rounded-full bg-success-bg px-2.5 py-0.5 text-xs font-semibold text-success">Faite</span>
      <% else %>
        <span class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-semibold text-neutral-600">À faire</span>
      <% end %>
    </div>
    <div class="flex items-center gap-4 px-6 py-5">
      <%= link_to "Modifier", edit_todo_path(@todo),
            class: "rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm font-medium text-neutral-700 shadow-xs hover:bg-neutral-50" %>
      <%= button_to "Supprimer", @todo, method: :delete,
            class: "cursor-pointer rounded-md border border-danger bg-white px-3 py-2 text-sm font-medium text-danger shadow-xs hover:bg-danger-bg",
            data: { turbo_confirm: "Supprimer cette tâche ?" } %>
    </div>
  </div>

  <%= link_to "← Retour aux tâches", todos_path, class: "mt-4 inline-block text-sm text-neutral-500 hover:text-brand-ink" %>
<% end %>
