<% content_for :title, "Nouvelle tâche — EE Boilerplate" %>

<%= render layout: "shared/app_shell", locals: { active: :todos } do %>
  <h1 class="mb-6 text-lg font-semibold text-brand-ink">Nouvelle tâche</h1>

  <div class="rounded-lg border border-neutral-200 bg-white p-6 shadow-xs">
    <%= render "form", todo: @todo %>
  </div>

  <%= link_to "← Retour aux tâches", todos_path, class: "mt-4 inline-block text-sm text-neutral-500 hover:text-brand-ink" %>
<% end %>
