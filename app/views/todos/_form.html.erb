<%= form_with model: todo, class: "space-y-4" do |form| %>
  <% if todo.errors.any? %>
    <div class="rounded-md bg-danger-bg px-4 py-3 text-sm text-danger">
      <p class="font-semibold"><%= pluralize(todo.errors.count, "erreur") %> :</p>
      <ul class="mt-1 list-disc pl-5">
        <% todo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Titre", class: "block text-sm font-medium text-neutral-700" %>
    <%= form.text_field :title,
          class: "mt-1 block w-full rounded-md border border-neutral-200 px-3 py-2 text-sm shadow-xs focus:border-brand-lime-500 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :done,
          class: "h-4 w-4 rounded border-neutral-300 text-brand-lime-600 focus:ring-brand-lime-500" %>
    <%= form.label :done, "Faite", class: "text-sm font-medium text-neutral-700" %>
  </div>

  <%= form.submit todo.new_record? ? "Créer la tâche" : "Enregistrer",
        class: "cursor-pointer rounded-md bg-brand-lime px-3 py-2 text-sm font-semibold text-brand-ink hover:bg-brand-lime-600" %>
<% end %>
