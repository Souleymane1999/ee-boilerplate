<% content_for :title, "Tableau de bord — EE Boilerplate" %>

<%= render layout: "shared/app_shell", locals: { active: :dashboard } do %>
  <div class="overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-xs">
    <div class="flex items-center gap-3 border-b border-neutral-100 px-6 py-4">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-success-bg text-success">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
        </svg>
      </span>
      <h1 class="text-lg font-semibold text-brand-ink">Statut de l'application</h1>
    </div>

    <div class="flex items-center justify-between px-6 py-5">
      <% if @database_connected %>
        <span class="inline-flex items-center rounded-full bg-success-bg px-3 py-1 text-sm font-semibold text-success">
          Base de données connectée
        </span>
      <% else %>
        <span class="inline-flex items-center rounded-full bg-danger-bg px-3 py-1 text-sm font-semibold text-danger">
          Base de données indisponible
        </span>
      <% end %>
      <code class="rounded bg-neutral-100 px-2 py-1 font-mono text-xs text-neutral-600"><%= rails_health_check_path %></code>
    </div>
  </div>
<% end %>
