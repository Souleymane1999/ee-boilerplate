# Copiez ce fichier en .env et ajustez les valeurs si besoin.
# .env n'est jamais commité (voir .gitignore).

# --- PostgreSQL (utilisé par le service postgres de docker-compose.yml) ---
POSTGRES_USER=ee_boilerplate
POSTGRES_PASSWORD=ee_boilerplate
POSTGRES_DB=ee_boilerplate_development
POSTGRES_PORT=5432

# --- Backend (Rails) ---
# URL complète utilisée par Rails pour se connecter à PostgreSQL.
# Doit correspondre aux variables POSTGRES_* ci-dessus quand on utilise docker-compose.
DATABASE_URL=postgres://ee_boilerplate:ee_boilerplate@postgres:5432/ee_boilerplate_development

# Clé de déchiffrement des credentials Rails (backend/config/credentials.yml.enc).
# NE JAMAIS commiter la vraie valeur. En CI, injectée via GitHub Secrets.
RAILS_MASTER_KEY=

# Environnement Rails
RAILS_ENV=development

# Secret utilisé par devise-jwt pour signer les JWT d'authentification.
# Générer une valeur avec `bin/rails secret`. NE JAMAIS commiter la vraie valeur.
DEVISE_JWT_SECRET_KEY=

# Origine autorisée pour le CORS (l'URL du frontend)
FRONTEND_URL=http://localhost:5173

# Port exposé par le backend
BACKEND_PORT=3000

# --- Observabilité ---
# DSN Sentry pour le backend. Laisser vide en local : Sentry ne s'initialise pas (no-op).
SENTRY_DSN=

# --- Frontend (Vite) ---
# Les variables consommées par le frontend DOIVENT être préfixées par VITE_.

# URL de l'API backend appelée par le frontend
VITE_API_URL=http://localhost:3000

# DSN Sentry pour le frontend. Laisser vide en local : Sentry ne s'initialise pas (no-op).
VITE_SENTRY_DSN=

# Port exposé par le frontend (Vite dev server)
FRONTEND_PORT=5173

# --- Backup (scripts/backup.sh / scripts/restore.sh) ---
# Optionnel : identifiants pour l'upload vers un stockage distant (S3 ou équivalent).
# Voir scripts/backup.sh et docs/backup-restore.md.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET=
